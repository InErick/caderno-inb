# Porta do servidor
PORT=3000

# Troque por um texto longo e aleatório (ex.: rode: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=troque-isto-por-um-segredo-grande

# Em produção (com HTTPS) deixe como production para o cookie de login ser "secure"
NODE_ENV=production

# Opcional: caminho do banco SQLite
# DB_PATH=./data/caderno.db
